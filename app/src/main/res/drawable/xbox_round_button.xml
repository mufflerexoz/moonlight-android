<?xml version="1.0" encoding="utf-8"?>
<!-- Circular header button: green on press, white ring on controller focus -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80107C10">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="oval">
                    <solid android:color="@color/xbox_green" />
                    <stroke android:width="@dimen/xbox_focus_stroke" android:color="@color/xbox_focus" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/xbox_green" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#B3333333" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
