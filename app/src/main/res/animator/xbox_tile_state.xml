<?xml version="1.0" encoding="utf-8"?>
<!-- Tile motion: shrink slightly under the finger, grow when focused (like the Xbox dashboard) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.95" android:duration="90" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.95" android:duration="90" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="90" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_activated="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.08" android:duration="160" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.08" android:duration="160" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="12dp" android:duration="160" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="160" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="160" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="160" android:valueType="floatType" />
        </set>
    </item>
</selector>
