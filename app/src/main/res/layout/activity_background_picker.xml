<?xml version="1.0" encoding="utf-8"?>
<!-- Xbox-style "MoonlightX background" picker on a green screen -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xbox_green"
    android:paddingLeft="@dimen/xbox_screen_padding"
    android:paddingRight="@dimen/xbox_screen_padding"
    android:paddingTop="32dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/pickerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="@string/xbox_background_title"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/xbox_background_blur"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <FrameLayout
                android:id="@+id/optionBlur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/xbox_bg_option"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/xbox_background_blur"
                android:nextFocusRight="@+id/optionGrey"
                android:padding="4dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:src="@drawable/xbox_bg_preview_blur" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="24dp"
            android:layout_marginStart="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/xbox_background_grey"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
            <FrameLayout
                android:id="@+id/optionGrey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/xbox_bg_option"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/xbox_background_grey"
                android:nextFocusLeft="@id/optionBlur"
                android:padding="4dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:src="@drawable/xbox_bg_preview_grey" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        android:text="@string/xbox_background_hint"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
</RelativeLayout>
