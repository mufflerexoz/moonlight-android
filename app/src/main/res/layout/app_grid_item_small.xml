<?xml version="1.0" encoding="utf-8"?>
<!-- Green Xbox-style game tile with box art. The title band appears only on the highlighted tile. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp"
    android:layout_height="154dp"
    android:background="@drawable/xbox_tile"
    android:stateListAnimator="@animator/xbox_tile_state">

    <ImageView
        android:id="@+id/grid_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:cropToPadding="false"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <!-- Shown by the art loader only when there is no box art -->
    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/grid_overlay"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/grid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/xbox_title_band"
        android:ellipsize="end"
        android:singleLine="true"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:textColor="@color/xbox_title_text"
        android:textSize="12sp"
        android:textStyle="bold" />
</FrameLayout>
