<!-- Xbox-style home: top bar with title, clock and round action buttons, then a tile grid -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xbox_background"
    tools:context=".PcView" >

    <LinearLayout
        android:id="@+id/xboxHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/xbox_header_padding"
        android:paddingRight="@dimen/xbox_header_padding"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/xboxLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/xbox_logo_mark">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_computer" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:layout_marginStart="14dp"
            android:text="@string/xbox_app_title"
            android:textSize="@dimen/xbox_title_size"
            style="@style/XboxTitle" />

        <TextClock
            android:id="@+id/xboxClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:layout_marginEnd="6dp"
            style="@style/XboxClock" />

        <ImageButton
            android:id="@+id/androidAppsButton"
            android:nextFocusDown="@+id/fragmentView"
            android:contentDescription="@string/xbox_section_android_apps"
            android:src="@drawable/ic_xbox_apps"
            style="@style/XboxHeaderButton" />

        <ImageButton
            android:id="@+id/manuallyAddPc"
            android:nextFocusDown="@+id/fragmentView"
            android:contentDescription="@string/title_add_pc"
            android:src="@drawable/ic_add"
            style="@style/XboxHeaderButton" />

        <ImageButton
            android:id="@+id/helpButton"
            android:nextFocusDown="@+id/fragmentView"
            android:contentDescription="@string/help"
            android:src="@drawable/ic_help"
            style="@style/XboxHeaderButton" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:nextFocusDown="@+id/fragmentView"
            android:contentDescription="@string/xbox_settings"
            android:src="@drawable/ic_settings"
            style="@style/XboxHeaderButton" />
    </LinearLayout>

    <TextView
        android:id="@+id/xboxSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/xboxHeader"
        android:layout_marginLeft="@dimen/xbox_screen_padding"
        android:layout_marginStart="@dimen/xbox_screen_padding"
        android:layout_marginTop="8dp"
        android:text="@string/xbox_section_pcs"
        style="@style/XboxSectionTitle" />

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/xboxSectionTitle"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/xbox_green_bright"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/xbox_text_primary"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:gravity="center"
                android:text="@string/searching_pc"/>
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
