<?xml version="1.0" encoding="utf-8"?>
<!-- MoonlightX logo; tapping it opens the background picker -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xboxLogo"
    android:layout_width="68dp"
    android:layout_height="68dp"
    android:padding="4dp"
    android:background="@drawable/xbox_logo_focus"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/xbox_background_title">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:src="@drawable/moonlightx_icon" />
</FrameLayout>
