<?xml version="1.0" encoding="utf-8"?>
<!-- Xbox-style tile for an installed Android app -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="128dp"
    android:layout_height="128dp"
    android:padding="5dp"
    android:background="@drawable/xbox_tile_frame"
    android:stateListAnimator="@animator/xbox_tile_state">

    <FrameLayout
        android:id="@+id/grid_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/xbox_tile_surface"
        android:foreground="@drawable/xbox_tile_ripple"
        android:duplicateParentState="true"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="2"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="10dp"
            android:textColor="@color/xbox_text_primary"
            android:textSize="13sp" />
    </FrameLayout>
</FrameLayout>
