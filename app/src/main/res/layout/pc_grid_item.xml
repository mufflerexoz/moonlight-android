<?xml version="1.0" encoding="utf-8"?>
<!-- Xbox-style PC tile. The outer frame draws the focus ring; the inner card is the tile. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="176dp"
    android:layout_height="176dp"
    android:padding="5dp"
    android:background="@drawable/xbox_tile_frame"
    android:stateListAnimator="@animator/xbox_tile_state">

    <FrameLayout
        android:id="@+id/grid_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/xbox_tile_surface"
        android:foreground="@drawable/xbox_tile_ripple"
        android:duplicateParentState="true"
        android:elevation="2dp">

        <RelativeLayout
            android:id="@+id/grid_image_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp">
            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_centerHorizontal="true"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="18dp"
                android:importantForAccessibility="no" />
            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/xbox_text_primary" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp">
            <TextView
                android:id="@+id/grid_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/xbox_text_primary"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/grid_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/xbox_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
